# The site's own canonical URL — feeds metadataBase, Open Graph, JSON-LD,
# and the sitemap (content/site.ts, sitemap.ts). Falls back to
# https://arthacoffee.com if unset, so this is only required if the real
# domain ever differs from that.
NEXT_PUBLIC_SITE_URL=https://arthacoffee.com

# --- Reservation email (Resend) ---------------------------------------
# https://resend.com — sends the reservation notification email to the
# restaurant and the confirmation email to the guest. Without
# RESEND_API_KEY set, the reservation endpoint logs submissions to the
# console instead of emailing anyone — safe for local development, not
# for production.
RESEND_API_KEY=

# Verified sending address in your Resend domain. Must be on a domain
# you've verified with Resend (see their dashboard) — unverified domains
# will fail to send or land in spam.
RESEND_FROM=hello@arthacoffee.com

# Where the restaurant notification email actually goes. Falls back to
# content/site.ts's `email` field if unset.
RESERVATION_EMAIL=sri@arthacoffee.com

# --- WhatsApp Business Cloud API ---------------------------------------
# https://developers.facebook.com/docs/whatsapp — sends a guest
# acknowledgement (receipt only, never a confirmed booking) after a
# reservation is submitted. Without WHATSAPP_ACCESS_TOKEN and
# WHATSAPP_PHONE_NUMBER_ID set, the endpoint logs and skips this step
# entirely — email remains the channel of record either way.
#
# Requires a Meta Business Manager account, a verified WhatsApp Business
# phone number, and a Message Template approved for business-initiated
# conversations. Full setup walkthrough, including the exact template
# body to submit for approval, in docs/API_INTEGRATIONS.md and
# docs/RESERVATION_SYSTEM.md — free-form text cannot be used to initiate
# contact with a guest who hasn't messaged the business first.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# The WhatsApp Business Account ID (distinct from the phone number ID
# above). Not read by any code path today — the current integration only
# sends messages, which needs just the phone number ID — but it's part
# of the full account setup (managing/submitting Message Templates via
# API, business verification) documented in docs/API_INTEGRATIONS.md, so
# it's recorded here for whoever does that setup.
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Must match the Message Template's exact approved name in Meta Business
# Manager. Defaults to "reservation_acknowledgement" if unset.
WHATSAPP_TEMPLATE_NAME=reservation_acknowledgement

# --- Google Calendar (not wired up yet) --------------------------------
# src/lib/google-calendar.ts is prepared architecture, not an active
# integration — nothing in the codebase calls it. These three are only
# needed once/if that changes. See that file's doc comment for full setup.
GOOGLE_CALENDAR_CLIENT_EMAIL=
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# --- Analytics -----------------------------------------------------------
# Every ID below is opt-in: unset means the corresponding script never
# loads, not a broken/empty integration. See src/components/layout/analytics.tsx.

# Google Analytics 4 measurement ID (starts with "G-").
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console's HTML-tag verification code (just the content
# value, not the full <meta> tag) — renders via the Metadata API's
# `verification.google` field in src/app/layout.tsx.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Microsoft Clarity project ID.
NEXT_PUBLIC_CLARITY_ID=

# Vercel Web Analytics and Speed Insights need no ID and no env var —
# @vercel/analytics and @vercel/speed-insights self-configure from
# Vercel's own build environment and are gated on that automatically
# (see src/components/layout/analytics.tsx), not listed here because
# there's nothing to set.

# --- Image pipeline (Cloudinary) ---------------------------------------
# Optional — see public/images/README.md and docs/IMAGE_GUIDE.md for when
# this is worth setting up versus using locally-hosted images instead.
# CLOUDINARY_API_KEY/SECRET are for the upload/admin API (a future upload
# script or admin tool); src/lib/cloudinary.ts's delivery-URL builder
# only needs CLOUDINARY_CLOUD_NAME.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
