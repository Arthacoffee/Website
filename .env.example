# Resend (https://resend.com) sends the reservation notification email to
# the restaurant and the confirmation email to the guest. Without this set,
# the reservation endpoint logs submissions to the console instead of
# emailing anyone — safe for local development, not for production.
RESEND_API_KEY=

# Verified sending address in your Resend domain. Must be on a domain you've
# verified with Resend (see their dashboard) — unverified domains will fail
# to send or land in spam.
RESERVATIONS_FROM_EMAIL=reservations@arthacoffee.com

# WhatsApp Business Cloud API (https://developers.facebook.com/docs/whatsapp) —
# sends a guest acknowledgement (receipt only, never a confirmed booking)
# after a reservation is submitted. Without WHATSAPP_ACCESS_TOKEN and
# WHATSAPP_PHONE_NUMBER_ID set, the endpoint logs and skips this step
# entirely — email remains the channel of record either way.
#
# Requires a Meta Business Manager account, a verified WhatsApp Business
# phone number, and a Message Template approved for business-initiated
# conversations (see docs/RESERVATION_SYSTEM.md for the exact template body
# to submit — free-form text cannot be used to initiate contact with a
# guest who hasn't messaged the business first).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Must match the Message Template's exact approved name in Meta Business
# Manager. Defaults to "reservation_acknowledgement" if unset.
WHATSAPP_TEMPLATE_NAME=reservation_acknowledgement
